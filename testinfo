def generate_demo_data(num_samples=1000, input_dim=151, output_dim=33, top_k=6):
    print("生成演示数据...")
    np.random.seed(seed)
    W = np.random.randn(input_dim, output_dim) * 0.5
    features = np.random.randn(num_samples, input_dim).astype(np.float32)
    labels   = np.zeros((num_samples, top_k), dtype=np.int64)
    for i in range(num_samples):
        s = features[i] @ W + np.random.randn(output_dim) * 2.0
        labels[i] = np.sort(np.argsort(s)[-top_k:])
    return features, labels
 
 
def load_data_from_file(filepath, cfg):
    data = np.loadtxt(filepath, delimiter=',')
    inp, k = cfg["input_dim"], cfg["top_k"]
    return data[:, :inp].astype(np.float32), data[:, inp:inp+k].astype(np.int64)
 
 
