def run_all_models_parallel(cfg, device, gpu_ids, features, labels,
                            max_parallel: int = 5) -> list:
    model_names = list(MODEL_REGISTRY.keys())
    total       = len(model_names)
    results     = []
    print_lock  = threading.Lock()
    done        = [0]
 
    streams = ([torch.cuda.Stream(device=device) for _ in model_names]
               if torch.cuda.is_available() else [None] * len(model_names))
 
    print(f"\n{'='*70}")
    print(f"  并行训练  共 {total} 个模型  最多 {max_parallel} 个同时运行")
    print(f"  二段切分: 训练 {cfg['train_ratio']*100:.0f}%  验证 {(1-cfg['train_ratio'])*100:.0f}%")
    print(f"  早停: 监控【训练集 loss】，验证集标签不影响训练")
    print(f"  自适应惩罚: {'开启' if cfg.get('use_adaptive_penalty', True) else '关闭'}")
    print(f"{'='*70}\n")
 
    with ThreadPoolExecutor(max_workers=max_parallel) as executor:
        future_map = {
            executor.submit(train_one_model, name, cfg, device, gpu_ids,
                            features, labels, streams[i]): name
            for i, name in enumerate(model_names)
        }
        for future in as_completed(future_map):
            name = future_map[future]
            try:
                result = future.result()
            except Exception as e:
                result = {"model": name, "error": str(e),
                          "log_lines": [], "detail_str": "", "val_loss": 99.9,
                          "params": 0, "hit_rate_top_k": 0.0,
                          "avg_top_correct": 0.0, "train_time_s": 0}
            results.append(result)
            with print_lock:
                done[0] += 1
                status = "✓" if not result.get("error") else "✗"
                print(f"\n{'='*70}")
                print(f"[{done[0]:2d}/{total}] {status} {name}  "
                      f"Val Loss: {result['val_loss']:.4f}  "
                      f"Avg Top: {result['avg_top_correct']:.2f}  "
                      f"耗时: {result['train_time_s']:.0f}s")
                for line in result.get("log_lines", []):
                    print(line)
                if result.get("detail_str"):
                    if defug_console == True:
                        print(result["detail_str"])
 
    return results
 
 
