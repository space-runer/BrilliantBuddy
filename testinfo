# 8. 训练器 —— v5 核心：基于训练 loss 的早停
# ============================================================
 
class Trainer:
    def __init__(self, model, cfg, device):
        self.model, self.cfg, self.device = model, cfg, device
        self.use_adaptive  = cfg.get("use_adaptive_penalty", True)
        self.warmup_epochs = cfg.get("penalty_warmup_epochs", 3)
        self.criterion     = AdaptivePenaltyFocalLoss(gamma=2.0, alpha=0.75)
        self.tracker       = (ErrorPenaltyTracker(cfg["output_dim"], cfg, device)
                              if self.use_adaptive else None)
        self.optimizer     = optim.AdamW(model.parameters(), lr=cfg["lr"],
                                         weight_decay=cfg["weight_decay"])
        self.scheduler     = optim.lr_scheduler.CosineAnnealingWarmRestarts(
            self.optimizer, T_0=10, T_mult=2)
 
        self.best_train_loss  = float('inf')
        self.patience_counter = 0
        self.best_state       = None
        self.current_epoch = 0
 
    def train_epoch(self, loader) -> float:
        self.model.train()
        total_loss, total = 0.0, 0
        penalty_active = (self.use_adaptive and
                          self.current_epoch >= self.warmup_epochs)
 
        for x, y in loader:
            x, y = x.to(self.device, non_blocking=True), y.to(self.device, non_blocking=True)
            self.optimizer.zero_grad()
            out  = self.model(x)
            loss = self.criterion(out, y, tracker=self.tracker,
                                  use_penalty=penalty_active)
            m = self.model.module if isinstance(self.model, nn.DataParallel) else self.model
            if hasattr(m, '_kl'):
                loss = loss + 0.001 * m._kl
            loss.backward()
            nn.utils.clip_grad_norm_(self.model.parameters(), max_norm=1.0)
            self.optimizer.step()
            if penalty_active and self.tracker is not None:
                self.tracker.update(out.detach(), y.detach())
            total_loss += loss.item() * x.size(0)
            total      += x.size(0)
 
        self.scheduler.step()
        return total_loss / total
 
    @torch.no_grad()
    def validate(self, loader):
        self.model.eval()
        total_loss, total = 0.0, 0
        all_preds, all_targets = [], []
        for x, y in loader:
            x, y = x.to(self.device, non_blocking=True), y.to(self.device, non_blocking=True)
            out  = self.model(x)
            loss = self.criterion(out, y, tracker=None, use_penalty=False)
            total_loss += loss.item() * x.size(0)
            total      += x.size(0)
            all_preds.append(torch.sigmoid(out).cpu())
            all_targets.append(y.cpu())
        return total_loss / total, torch.cat(all_preds), torch.cat(all_targets)
 
    def fit(self, train_loader, val_loader, log_lines: Optional[list] = None):
        def emit(msg):
            if log_lines is not None: log_lines.append(msg)
            else: print(msg)
 
        emit(f"  早停策略: 监控【训练集 loss】连续 {self.cfg['patience']} epoch "
             f"不下降则停止（验证集标签不影响训练）")
        if self.use_adaptive:
            emit(f"  自适应错误惩罚: 已启用  "
                 f"warmup={self.warmup_epochs}epoch  "
                 f"ema_alpha={self.cfg['penalty_ema_alpha']}  "
                 f"scale_fp={self.cfg['penalty_scale_fp']}  "
                 f"scale_fn={self.cfg['penalty_scale_fn']}  "
                 f"max_penalty={self.cfg['penalty_max']}")
        else:
            emit("  自适应错误惩罚: 已关闭")
 
        for epoch in range(1, self.cfg["epochs"] + 1):
            self.current_epoch = epoch
            t0 = time.time()
 
            train_loss = self.train_epoch(train_loader)
            val_loss, val_preds, val_targets = self.validate(val_loader)
 
            elapsed = time.time() - t0
            metrics = self.compute_metrics(val_preds, val_targets)
 
            if epoch % 10 == 0 or epoch == 1:
                penalty_info = ""
                if self.use_adaptive and self.tracker is not None:
                    stats = self.tracker.get_stats()
                    pa    = epoch >= self.warmup_epochs
                    penalty_info = (
                        f" | 惩罚{'激活' if pa else '预热'} "
                        f"FP:{stats['mean_fp_penalty']:.2f}x "
                        f"FN:{stats['mean_fn_penalty']:.2f}x"
                    )
                emit(f"  Epoch {epoch:3d}/{self.cfg['epochs']} | "
                     f"Train {train_loss:.4f}{'↓' if train_loss < self.best_train_loss else ' '} | "
                     f"Val(仅展示) {val_loss:.4f} | "
                     f"Hit(top{self.cfg['top_k']}) {metrics['hit_rate_top_k']:.4f} | "
                     f"LR {self.optimizer.param_groups[0]['lr']:.6f} | "
                     f"{elapsed:.1f}s{penalty_info}")
 
            if train_loss < self.best_train_loss:
                self.best_train_loss  = train_loss
                self.patience_counter = 0
                self.best_state = {k: v.cpu().clone()
                                   for k, v in self.model.state_dict().items()}
            else:
                self.patience_counter += 1
                if self.patience_counter >= self.cfg["patience"]:
                    emit(f"  早停 @ Epoch {epoch}  "
                         f"(train_loss 连续 {self.cfg['patience']} epoch 未下降)  "
                         f"最佳 train_loss: {self.best_train_loss:.4f}")
                    break
 
        if self.best_state:
            self.model.load_state_dict(self.best_state)
            self.model.to(self.device)
        return self.best_train_loss
 
    def compute_metrics(self, preds, targets):
        B     = preds.size(0)
        top_k = self.cfg["top_k"]
        _, pred_top = preds.topk(top_k, dim=1)
        hit = sum(
            1 if set(targets[i].nonzero(as_tuple=True)[0].tolist()) & set(pred_top[i].tolist()) else 0
            for i in range(B)
        ) / B
        return {"hit_rate_top_k": hit}
 
 
