def count_pair_occurrences(lists):
    """
    统计多个列表中，两两组合出现的次数，并按从低到高排序。
    Args:
        lists: 包含多个列表的列表，例如 [[1,2,3], [4,5,6]]
    Returns:
        排序后的列表，每个元素为 (组合元组, 出现次数)
    """
    pair_counter = Counter()
    
    for lst in lists:
        
        unique_lst = list(set(lst))
        
        # 生成当前列表中所有长度为2的无序组合
        # combinations 生成的元组是有序的 (小, 大)，天然适合做键
        pairs = combinations(sorted(unique_lst), 3)
        
        # 更新计数器
        pair_counter.update(pairs)
        
    # sorted_pairs = sorted(pair_counter.items(), key=lambda x: x)
    sorted_pairs = sorted(pair_counter.items(), key=lambda x: x[1])
    
    return sorted_pairs

