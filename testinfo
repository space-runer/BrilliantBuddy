# 4b. make_loaders — v5 二段切分（恢复 train/val）
# ============================================================
 
def make_loaders(features: np.ndarray, labels: np.ndarray, cfg: dict,
                 num_workers: int = 0):
    """
    【v5】恢复二段切分：train (train_ratio) / val (剩余)。
    val_ds 仅用于评估指标展示，不参与早停决策，
    因此修改 val 标签不影响模型训练和输出。
    """
    N_raw         = len(features)
    W             = cfg["window_size"]
    total_windows = N_raw - W + 1
    raw_train_size = int(N_raw * cfg["train_ratio"])
    safe_train_end = raw_train_size - W + 1   # 训练集窗口数
 
    if safe_train_end <= 0:
        raise ValueError(
            f"训练集窗口数为0！(N_raw={N_raw}, train_ratio={cfg['train_ratio']}, W={W})")
    if safe_train_end >= total_windows:
        raise ValueError(
            f"测试集窗口数为0！(safe_train_end={safe_train_end}, total_windows={total_windows})")
 
    full_ds = SlidingWindowDataset(features, labels, cfg["output_dim"], W)
    train_indices = list(range(safe_train_end))
    val_indices   = list(range(safe_train_end, total_windows))
    train_ds = Subset(full_ds, train_indices)
    val_ds   = Subset(full_ds, val_indices)

    _pin  = torch.cuda.is_available()          # GPU 时 pin，CPU 时 False
    _pw   = num_workers > 0                    # 有 worker 才开 persistent
    _pf   = 2 if _pw else None
 
    train_loader = DataLoader(train_ds, batch_size=cfg["batch_size"],
                              shuffle=True,  num_workers=num_workers,
                              pin_memory=_pin,
                              persistent_workers=_pw,
                              prefetch_factor=_pf,)
    val_loader   = DataLoader(val_ds,   batch_size=cfg["batch_size"],
                              shuffle=False, num_workers=num_workers,
                              pin_memory=_pin,
                              persistent_workers=_pw,
                              prefetch_factor=_pf,)
 
    print(f"  原始数据行数: {N_raw}  window_size: {W}")
    print(f"  二段切分 (时序顺序，无边界泄漏):")
    print(f"    训练集: {len(train_indices):5d} 窗口  原始行 [0, {raw_train_size-1}]"
          f"  ← 梯度更新 + 早停监控(train loss)")
    print(f"    验证集: {len(val_indices):5d} 窗口  原始行 [{raw_train_size-W+1}, {N_raw-1}]"
          f"  ← 仅展示指标，不影响早停 ✓")
 
    return full_ds, train_ds, val_ds, train_loader, val_loader, raw_train_size
 
 
