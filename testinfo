# 16. 新增模型 (近2年经过验证的高效架构)
# ============================================================
 
# ── 16-A. SegRNN (2023) ──────────────────────────────────────
# 论文: SegRNN: Segment Recurrent Neural Network for Long-Term Time Series Forecasting
# 核心思路: 以"段"替代"步"进行 RNN 迭代，大幅减少迭代次数、保留局部时序结构
class SegRNNModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        W   = cfg["window_size"]          # 6
        C   = cfg["input_dim"]            # 54
        seg = cfg.get("segrnn_seg_len", 2)
        h   = cfg.get("segrnn_hidden", 64)
        nl  = cfg.get("segrnn_num_layers", 2)
 
        # 自动调整 seg_len 使其能整除 W
        while W % seg != 0 and seg > 1:
            seg -= 1
        self.seg_len  = seg               # 2  → num_segs=3
        self.num_segs = W // seg
 
        self.revin = _RevIN(C)
        # 段嵌入: 将每段展平后映射到隐层
        self.embed = nn.Linear(C * seg, h)
        self.pos   = nn.Parameter(torch.zeros(1, self.num_segs, h))
        self.rnn   = nn.GRU(h, h, num_layers=nl, batch_first=True,
                             dropout=0.1 if nl > 1 else 0.0)
        self.head  = nn.Sequential(
            nn.LayerNorm(h),
            nn.Linear(h, h // 2), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(h // 2, cfg["output_dim"]))
 
    def forward(self, x):                             # (B, W, C)
        x = self.revin(x)
        B = x.size(0)
        # 切段: (B, num_segs, seg_len*C)
        x_seg = x.reshape(B, self.num_segs, self.seg_len * x.size(2))
        h = self.embed(x_seg) + self.pos              # (B, num_segs, hidden)
        out, _ = self.rnn(h)
        return self.head(out[:, -1, :])
 
 
# ── 16-B. Mamba (NeurIPS 2023) ────────────────────────────────
# 论文: Mamba: Linear-Time Sequence Modeling with Selective State Spaces
# 核心: 选择性状态空间模型 (S6)，输入驱动的 SSM 参数，线性时间复杂度
# 实现: 纯 PyTorch，短序列(W=6)下顺序扫描代价可忽略
 
class _MambaBlock(nn.Module):
    """单个 Mamba (S6) 块。"""
    def __init__(self, d_model: int, d_state: int = 8, d_conv: int = 3, expand: int = 2):
        super().__init__()
        d_inner      = int(expand * d_model)
        self.d_inner = d_inner
        self.d_state = d_state
 
        self.norm    = nn.LayerNorm(d_model)
        # x 与门控 z 一起投影
        self.in_proj = nn.Linear(d_model, d_inner * 2, bias=False)
        # 因果深度可分卷积 (padding 右截断实现因果)
        self.conv1d  = nn.Conv1d(d_inner, d_inner, d_conv,
                                  padding=d_conv - 1, groups=d_inner, bias=True)
        self.act     = nn.SiLU()
        # 选择性 SSM 参数投影: [log_dt(1), B(d_state), C(d_state)]
        self.x_proj  = nn.Linear(d_inner, 1 + d_state * 2, bias=False)
        self.dt_proj = nn.Linear(1, d_inner, bias=True)
        # 固定衰减矩阵 A (可学习 log 尺度)
        A = torch.arange(1, d_state + 1, dtype=torch.float).unsqueeze(0).repeat(d_inner, 1)
        self.A_log   = nn.Parameter(torch.log(A))
        # 跳连系数 D
        self.D       = nn.Parameter(torch.ones(d_inner))
        self.out_proj= nn.Linear(d_inner, d_model, bias=False)
 
    def _selective_scan(self, u: torch.Tensor, dt: torch.Tensor,
                         B_mat: torch.Tensor, C_mat: torch.Tensor) -> torch.Tensor:
        """
        顺序 SSM 扫描 (window=6 时代价极小)
        u, dt : (batch, L, d_inner)
        B_mat, C_mat : (batch, L, d_state)
        return  : (batch, L, d_inner)
        """
        batch, L, _ = u.shape
        A    = -torch.exp(self.A_log.float())                          # (d_inner, d_state)
        h    = u.new_zeros(batch, self.d_inner, self.d_state)
        outs = []
        for t in range(L):
            dt_t = dt[:, t, :]                                         # (B, d_inner)
            # 离散化: ΔA, ΔB
            dA   = torch.exp(dt_t.unsqueeze(-1) * A.unsqueeze(0))     # (B, d_inner, d_state)
            dB_u = dt_t.unsqueeze(-1) * B_mat[:, t, :].unsqueeze(1) \
                   * u[:, t, :].unsqueeze(-1)                          # (B, d_inner, d_state)
            h    = h * dA + dB_u
            y    = (h * C_mat[:, t, :].unsqueeze(1)).sum(-1)           # (B, d_inner)
            outs.append(y)
        y = torch.stack(outs, dim=1)                                   # (B, L, d_inner)
        return y + u * self.D                                          # 跳连
 
    def forward(self, x: torch.Tensor) -> torch.Tensor:               # (B, L, d_model)
        res   = x
        x     = self.norm(x)
        B, L, _ = x.shape
 
        xz    = self.in_proj(x)                                        # (B, L, 2*d_inner)
        x_in, z = xz.chunk(2, dim=-1)
 
        # 因果卷积 (右截断保证因果性)
        xc    = self.conv1d(x_in.transpose(1, 2))[:, :, :L].transpose(1, 2)
        xc    = self.act(xc)                                           # (B, L, d_inner)
 
        # 选择性 SSM 参数
        x_dbl = self.x_proj(xc)                                       # (B, L, 1+d_state*2)
        dt_r, B_mat, C_mat = x_dbl.split([1, self.d_state, self.d_state], dim=-1)
        dt    = F.softplus(self.dt_proj(dt_r))                         # (B, L, d_inner)
 
        y     = self._selective_scan(xc, dt, B_mat, C_mat)
        y     = y * self.act(z)                                        # 门控
        return res + self.out_proj(y)
 
 
class MambaModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        d  = cfg.get("mamba_hidden", 64)
        nl = cfg.get("mamba_layers", 3)
        ds = cfg.get("mamba_d_state", 8)
        dc = cfg.get("mamba_d_conv", 3)
        ex = cfg.get("mamba_expand", 2)
 
        self.proj   = nn.Linear(cfg["input_dim"], d)
        self.blocks = nn.Sequential(*[_MambaBlock(d, ds, dc, ex) for _ in range(nl)])
        self.norm   = nn.LayerNorm(d)
        self.head   = nn.Sequential(
            nn.Linear(d, d // 2), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(d // 2, cfg["output_dim"]))
 
    def forward(self, x):                                             # (B, W, C)
        h = self.proj(x)                                              # (B, W, d)
        h = self.blocks(h)
        return self.head(self.norm(h)[:, -1, :])
 
 
# ── 16-C. MICN (ICLR 2023) ───────────────────────────────────
# 论文: MICN: Multi-scale Isometric Convolution Network for Time Series Forecasting
# 核心: 多尺度卷积分支并行提取局部和全局时序模式，避免 Transformer 的 O(n²) 注意力
class _MICNLayer(nn.Module):
    def __init__(self, d_model: int, kernel: int):
        super().__init__()
        # 等距卷积核 (padding=kernel//2 保持序列长度不变)
        self.conv = nn.Conv1d(d_model, d_model, kernel,
                               padding=kernel // 2, bias=True)
        self.norm = nn.BatchNorm1d(d_model)
        self.act  = nn.GELU()
 
    def forward(self, x):    # x: (B, D, L)
        return self.act(self.norm(self.conv(x))) + x   # 残差
 
 
class MICNModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        d       = cfg.get("micn_hidden", 64)
        kernels = cfg.get("micn_conv_kernel", [1, 3])
 
        self.proj     = nn.Linear(cfg["input_dim"], d)
        # 每个尺度两层等距卷积
        self.branches = nn.ModuleList(
            [nn.Sequential(_MICNLayer(d, k), _MICNLayer(d, k)) for k in kernels])
        # 多尺度融合
        self.merge    = nn.Linear(d * len(kernels), d)
        self.norm     = nn.LayerNorm(d)
        self.head     = nn.Sequential(
            nn.Linear(d, d // 2), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(d // 2, cfg["output_dim"]))
 
    def forward(self, x):                             # (B, W, C)
        h = self.proj(x).permute(0, 2, 1)             # (B, d, W)
        # 各尺度全局平均池化后拼接
        outs = [branch(h).mean(dim=2) for branch in self.branches]  # [(B,d),...]
        h    = self.norm(self.merge(torch.cat(outs, dim=-1)))        # (B, d)
        return self.head(h)
 
# ── 16-D. SparseTSF (ICML 2024) ──────────────────────────────
# 论文: SparseTSF: Modeling Long-term Time Series Forecasting with ~1k Parameters
# 核心: 周期性稀疏采样 + 极轻量线性层，~1k 参数即可媲美大模型
# 适配: 在本任务中用于多标签分类
class SparseTSFModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        W    = cfg["window_size"]         # 6
        C    = cfg["input_dim"]           # 54
        plen = cfg.get("sparsetSF_period_len", 2)
 
        plen = max(1, min(plen, W))
        self.period_len = plen
        # 向上取整: 每个周期内的段数
        self.seg_num    = math.ceil(W / plen)   # ceil(6/2)=3
 
        self.revin      = _RevIN(C)
        # 核心: 极轻量周期混合线性层 (per-channel)
        self.sparse_lin = nn.Linear(self.seg_num, self.seg_num, bias=False)
 
        flat = self.seg_num * C                 # 3*54=162
        self.head = nn.Sequential(
            nn.Linear(flat, 64), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(64, cfg["output_dim"]))
 
    def forward(self, x):                      # (B, W, C)
        B, W, C = x.shape
        x = self.revin(x)
 
        # 右补齐至 period_len 的整倍数
        pad = (self.period_len - W % self.period_len) % self.period_len
        if pad:
            x = torch.cat([x, x[:, -pad:, :]], dim=1)
 
        # 稀疏采样: 每隔 period_len 取一点 → (B, seg_num, C)
        x_sparse = x[:, ::self.period_len, :][:, :self.seg_num, :]
 
        # 周期混合: (B, C, seg_num) → sparse_lin → (B, C, seg_num)
        h = self.sparse_lin(x_sparse.permute(0, 2, 1)).permute(0, 2, 1)  # (B, seg_num, C)
 
        return self.head(h.reshape(B, -1))

