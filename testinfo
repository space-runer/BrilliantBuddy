class ResNetTransformer(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        inp, d = cfg["input_dim"], cfg["transformer_d_model"]
        self.input_proj = nn.Linear(inp, d)
        prev, res = d, []
        for h in cfg["resnet_layers"]:
            res.append(ResidualBlock(prev, h, cfg["resnet_dropout"])); prev = h
        self.res_blocks   = nn.Sequential(*res)
        self.res_out_proj = nn.Linear(prev, d)
        self.pos_enc      = PositionalEncoding(d, max_len=cfg["window_size"] + 10)
        enc = nn.TransformerEncoderLayer(d_model=d, nhead=cfg["transformer_nhead"],
            dim_feedforward=cfg["transformer_dim_ff"], dropout=cfg["transformer_dropout"],
            batch_first=True, activation='gelu')
        self.transformer = nn.TransformerEncoder(enc, num_layers=cfg["transformer_num_layers"])
        self.head = nn.Sequential(nn.Linear(d, d), nn.GELU(),
            nn.Dropout(cfg["transformer_dropout"]), nn.Linear(d, cfg["output_dim"]))
 
    def forward(self, x):
        B, W, _ = x.shape
        h = self.input_proj(x)
        h = self.res_out_proj(self.res_blocks(h.reshape(B*W, -1))).reshape(B, W, -1)
        return self.head(self.transformer(self.pos_enc(h))[:, -1, :])
 
 
class ImprovedTransformer(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        d = cfg["transformer_d_model"]
        self.proj = nn.Sequential(nn.Linear(cfg["input_dim"], d), nn.GELU(), nn.LayerNorm(d))
        self.pos  = PositionalEncoding(d)
        enc = nn.TransformerEncoderLayer(d_model=d, nhead=cfg["transformer_nhead"],
            dim_feedforward=cfg["transformer_dim_ff"], dropout=cfg["transformer_dropout"],
            batch_first=True, activation='gelu')
        self.encoder = nn.TransformerEncoder(enc, num_layers=cfg["transformer_num_layers"])
        self.pool    = Attention(d)
        self.head    = nn.Sequential(nn.Linear(d, d), nn.GELU(), nn.Dropout(0.1),
            nn.Linear(d, d // 2), nn.GELU(), nn.Linear(d // 2, cfg["output_dim"]))
 
    def forward(self, x):
        return self.head(self.pool(self.encoder(self.pos(self.proj(x)))))
 
 
class TransformerVAE(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        d, z = cfg["transformer_d_model"], cfg["vae_latent_dim"]
        self.proj = nn.Sequential(nn.Linear(cfg["input_dim"], d), nn.GELU())
        self.pos  = PositionalEncoding(d)
        enc = nn.TransformerEncoderLayer(d_model=d, nhead=cfg["transformer_nhead"],
            dim_feedforward=cfg["transformer_dim_ff"], dropout=cfg["transformer_dropout"],
            batch_first=True, activation='gelu')
        self.encoder = nn.TransformerEncoder(enc, num_layers=cfg["transformer_num_layers"])
        self.fc_mu   = nn.Linear(d, z)
        self.fc_var  = nn.Linear(d, z)
        self.decoder = nn.Sequential(nn.Linear(z, d), nn.GELU(), nn.Dropout(0.1),
            nn.Linear(d, cfg["output_dim"]))
        self._kl = torch.tensor(0.0)
 
    def reparameterize(self, mu, lv):
        return mu + torch.randn_like(mu) * torch.exp(0.5 * lv) if self.training else mu
 
    def forward(self, x):
        h = self.encoder(self.pos(self.proj(x)))[:, -1, :]
        mu, lv = self.fc_mu(h), self.fc_var(h)
        self._kl = (-0.5 * torch.mean(1 + lv - mu.pow(2) - lv.exp())
                    if self.training else torch.tensor(0.0))
        return self.decoder(self.reparameterize(mu, lv))
 
 
class PureResNet(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        prev   = cfg["input_dim"] * cfg["window_size"]
        blocks = []
        for h in cfg["resnet_layers"]:
            blocks.append(ResidualBlock(prev, h, cfg["resnet_dropout"])); prev = h
        self.backbone = nn.Sequential(*blocks)
        self.head = nn.Sequential(nn.Linear(prev, prev // 2), nn.GELU(),
            nn.Dropout(0.2), nn.Linear(prev // 2, cfg["output_dim"]))
 
    def forward(self, x):
        return self.head(self.backbone(x.reshape(x.size(0), -1)))
 
 
class DenseBlock(nn.Module):
    def __init__(self, in_dim, growth):
        super().__init__()
        self.fc = nn.Sequential(nn.BatchNorm1d(in_dim), nn.GELU(), nn.Linear(in_dim, growth))
 
    def forward(self, x):
        return torch.cat([x, self.fc(x)], dim=-1)
 
 
class DenseNet1D(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        g, n = cfg["densenet_growth_rate"], cfg["densenet_num_layers"]
        dim  = cfg["input_dim"] * cfg["window_size"]
        layers = []
        for _ in range(n):
            layers.append(DenseBlock(dim, g)); dim += g
        self.dense = nn.Sequential(*layers)
        self.head  = nn.Sequential(nn.BatchNorm1d(dim), nn.GELU(),
            nn.Linear(dim, 128), nn.GELU(), nn.Dropout(0.2),
            nn.Linear(128, cfg["output_dim"]))
 
    def forward(self, x):
        return self.head(self.dense(x.reshape(x.size(0), -1)))
 
 
class BiLSTMModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        h = cfg["bilstm_hidden"]
        self.proj = nn.Linear(cfg["input_dim"], h)
        self.lstm = nn.LSTM(h, h, num_layers=cfg["bilstm_layers"],
            batch_first=True, bidirectional=True, dropout=0.2)
        self.attn = Attention(h * 2)
        self.head = nn.Sequential(nn.Linear(h * 2, h), nn.GELU(),
            nn.Dropout(0.2), nn.Linear(h, cfg["output_dim"]))
 
    def forward(self, x):
        return self.head(self.attn(self.lstm(self.proj(x))[0]))
 
 
class TCNModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        chs, ks = cfg["tcn_channels"], cfg["tcn_kernel_size"]
        self.input_proj = nn.Linear(cfg["input_dim"], chs[0])
        self.tcn  = nn.Sequential(*[TemporalBlock(chs[i], chs[i+1], ks, dilation=2**i)
                                     for i in range(len(chs)-1)])
        self.head = nn.Sequential(nn.Linear(chs[-1], 64), nn.GELU(),
            nn.Dropout(0.2), nn.Linear(64, cfg["output_dim"]))
 
    def forward(self, x):
        return self.head(self.tcn(self.input_proj(x).permute(0, 2, 1))[:, :, -1])
 
 
class GRUAttentionModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        h = cfg["gru_hidden"]
        self.proj = nn.Linear(cfg["input_dim"], h)
        self.gru  = nn.GRU(h, h, num_layers=cfg["gru_layers"], batch_first=True, dropout=0.2)
        self.mha  = nn.MultiheadAttention(h, num_heads=4, batch_first=True, dropout=0.1)
        self.norm = nn.LayerNorm(h)
        self.head = nn.Sequential(nn.Linear(h, h), nn.GELU(),
            nn.Dropout(0.2), nn.Linear(h, cfg["output_dim"]))
 
    def forward(self, x):
        o, _ = self.gru(self.proj(x))
        a, _ = self.mha(o, o, o)
        return self.head(self.norm(o + a)[:, -1, :])
 
 
class CNN1DModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        chs, ks = cfg["cnn_channels"], cfg["cnn_kernel_size"]
        layers, in_ch = [], cfg["input_dim"]
        for out_ch in chs:
            layers += [nn.Conv1d(in_ch, out_ch, ks, padding=ks//2),
                       nn.BatchNorm1d(out_ch), nn.GELU(), nn.Dropout(0.2)]
            in_ch = out_ch
        self.conv = nn.Sequential(*layers)
        self.head = nn.Sequential(nn.Linear(in_ch, in_ch // 2), nn.GELU(),
            nn.Dropout(0.2), nn.Linear(in_ch // 2, cfg["output_dim"]))
 
    def forward(self, x):
        return self.head(self.conv(x.permute(0, 2, 1)).mean(dim=2))
 
 
class HybridCNNLSTMModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        c, h = cfg["hybrid_cnn_ch"], cfg["hybrid_lstm_hidden"]
        self.feat_cnn  = nn.Sequential(
            nn.Conv1d(1, c, 5, padding=2), nn.GELU(),
            nn.Conv1d(c, c, 3, padding=1), nn.GELU())
        self.feat_pool = nn.AdaptiveAvgPool1d(1)
        self.lstm = nn.LSTM(c, h, num_layers=2, batch_first=True, bidirectional=True, dropout=0.2)
        self.attn = Attention(h * 2)
        self.head = nn.Sequential(nn.Linear(h * 2, h), nn.GELU(),
            nn.Dropout(0.2), nn.Linear(h, cfg["output_dim"]))
 
    def forward(self, x):
        B, W, C = x.shape
        feat = self.feat_pool(self.feat_cnn(x.reshape(B*W, 1, C))).squeeze(-1).reshape(B, W, -1)
        return self.head(self.attn(self.lstm(feat)[0]))
 
 
class MLPMixerLayer(nn.Module):
    def __init__(self, num_patches, hidden, mlp_ratio=4):
        super().__init__()
        ex = hidden * mlp_ratio
        self.norm1       = nn.LayerNorm(hidden)
        self.token_mix   = nn.Sequential(nn.Linear(num_patches, ex), nn.GELU(),
                                          nn.Linear(ex, num_patches))
        self.norm2       = nn.LayerNorm(hidden)
        self.channel_mix = nn.Sequential(nn.Linear(hidden, ex), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(ex, hidden))
 
    def forward(self, x):
        x = x + self.token_mix(self.norm1(x).transpose(1, 2)).transpose(1, 2)
        return x + self.channel_mix(self.norm2(x))
 
 
class MLPMixerModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        W, d = cfg["window_size"], cfg["mixer_hidden"]
        self.proj   = nn.Linear(cfg["input_dim"], d)
        self.layers = nn.Sequential(*[MLPMixerLayer(W, d) for _ in range(cfg["mixer_depth"])])
        self.norm   = nn.LayerNorm(d)
        self.head   = nn.Sequential(nn.Linear(d, d // 2), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(d // 2, cfg["output_dim"]))
 
    def forward(self, x):
        return self.head(self.norm(self.layers(self.proj(x))).mean(dim=1))
 
 
class WaveNetBlock(nn.Module):
    def __init__(self, ch, kernel_size, dilation):
        super().__init__()
        pad = (kernel_size - 1) * dilation
        self.conv_f = nn.Conv1d(ch, ch, kernel_size, padding=pad, dilation=dilation)
        self.conv_g = nn.Conv1d(ch, ch, kernel_size, padding=pad, dilation=dilation)
        self.res    = nn.Conv1d(ch, ch, 1)
        self.skip   = nn.Conv1d(ch, ch, 1)
 
    def forward(self, x):
        T   = x.size(2)
        act = torch.tanh(self.conv_f(x)[:, :, :T]) * torch.sigmoid(self.conv_g(x)[:, :, :T])
        return x + self.res(act), self.skip(act)
 
 
class WaveNetModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        ch, n = cfg["wavenet_channels"], cfg["wavenet_layers"]
        self.input_conv = nn.Conv1d(cfg["input_dim"], ch, 1)
        self.blocks     = nn.ModuleList([WaveNetBlock(ch, 2, 2**i) for i in range(n)])
        self.out        = nn.Sequential(nn.ReLU(), nn.Conv1d(ch, ch, 1),
            nn.ReLU(), nn.Conv1d(ch, ch, 1))
        self.head       = nn.Sequential(nn.Linear(ch, ch // 2), nn.GELU(),
            nn.Dropout(0.2), nn.Linear(ch // 2, cfg["output_dim"]))
 
    def forward(self, x):
        h = self.input_conv(x.permute(0, 2, 1))
        skip_sum = 0
        for blk in self.blocks:
            h, skip = blk(h); skip_sum = skip_sum + skip
        return self.head(self.out(skip_sum)[:, :, -1])
 
 
class CrossFormerModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        d, nh, W = cfg["crossformer_d_model"], cfg["crossformer_nhead"], cfg["window_size"]
        self.proj      = nn.Linear(cfg["input_dim"], d)
        self.time_attn = nn.MultiheadAttention(d, nh, batch_first=True, dropout=0.1)
        self.time_norm = nn.LayerNorm(d)
        feat_nhead = min(W, nh)
        while feat_nhead > 1 and W % feat_nhead != 0:
            feat_nhead -= 1
        self.feat_attn = nn.MultiheadAttention(W, feat_nhead, batch_first=True, dropout=0.1)
        self.feat_norm = nn.LayerNorm(W)
        self.ffn  = nn.Sequential(nn.Linear(d * W, d * 2), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(d * 2, d))
        self.head = nn.Sequential(nn.Linear(d, d // 2), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(d // 2, cfg["output_dim"]))
 
    def forward(self, x):
        B = x.size(0)
        h = self.proj(x)
        ta, _ = self.time_attn(h, h, h);   h  = self.time_norm(h + ta)
        hT = h.permute(0, 2, 1)
        fa, _ = self.feat_attn(hT, hT, hT); hT = self.feat_norm(hT + fa)
        return self.head(self.ffn(hT.permute(0, 2, 1).reshape(B, -1)))
 
 
class PatchTSTModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        W, pl, d  = cfg["window_size"], cfg["patchtst_patch_len"], cfg["patchtst_d_model"]
        num_patches = W // pl + (1 if W % pl else 0)
        self.patch_len  = pl
        self.patch_proj = nn.Linear(cfg["input_dim"] * pl, d)
        self.cls_token  = nn.Parameter(torch.zeros(1, 1, d))
        self.pos        = nn.Parameter(torch.zeros(1, num_patches + 1, d))
        enc = nn.TransformerEncoderLayer(d_model=d, nhead=cfg["patchtst_nhead"],
            dim_feedforward=d*4, dropout=0.1, batch_first=True, activation='gelu')
        self.encoder = nn.TransformerEncoder(enc, num_layers=cfg["patchtst_num_layers"])
        self.norm    = nn.LayerNorm(d)
        self.head    = nn.Sequential(nn.Linear(d, d // 2), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(d // 2, cfg["output_dim"]))
 
    def forward(self, x):
        B, W, C = x.shape
        pl  = self.patch_len
        pad = (pl - W % pl) % pl
        if pad: x = torch.cat([x, x[:, -pad:, :]], dim=1)
        h = self.patch_proj(x.reshape(B, -1, pl * C))
        h = torch.cat([self.cls_token.expand(B, -1, -1), h], dim=1) + self.pos[:, :h.size(1)+1, :]
        return self.head(self.norm(self.encoder(h))[:, 0, :])
 
 
class TimesBlock(nn.Module):
    def __init__(self, d, ff, period):
        super().__init__()
        self.period = period
        self.conv   = nn.Sequential(nn.Conv2d(d, ff, 3, padding=1), nn.GELU(),
            nn.Conv2d(ff, d, 3, padding=1))
        self.norm   = nn.LayerNorm(d)
 
    def forward(self, x):
        B, T, D = x.shape; P = self.period
        pad = (P - T % P) % P
        xp  = torch.cat([x, x[:, :pad, :]], dim=1) if pad else x
        T2  = xp.size(1)
        h   = xp.reshape(B, T2//P, P, D).permute(0, 3, 1, 2)
        h   = self.conv(h).permute(0, 2, 3, 1).reshape(B, T2, D)[:, :T, :]
        return self.norm(x + h)
 
 
class TimesNetModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        W, d, ff = cfg["window_size"], cfg["timesnet_d_model"], cfg["timesnet_d_ff"]
        self.proj   = nn.Linear(cfg["input_dim"], d)
        self.blocks = nn.ModuleList([TimesBlock(d, ff, p) for p in [p for p in [1,2,3] if p <= W]])
        self.head   = nn.Sequential(nn.Linear(d, d), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(d, cfg["output_dim"]))
 
    def forward(self, x):
        h = self.proj(x)
        for blk in self.blocks: h = blk(h)
        return self.head(h[:, -1, :])
 
 
class NLinearModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        self.linear = nn.Linear(cfg["window_size"] * cfg["input_dim"], cfg["output_dim"])
 
    def forward(self, x):
        return self.linear((x - x[:, -1:, :]).reshape(x.size(0), -1))
 
 
class DLinearModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        flat = cfg["window_size"] * cfg["input_dim"]
        self.trend    = nn.Linear(flat, cfg["output_dim"])
        self.seasonal = nn.Linear(flat, cfg["output_dim"])
        self.ks       = min(cfg["window_size"], 3)
 
    def _ma(self, x):
        front = x[:, :1, :].expand(-1, self.ks-1, -1)
        return F.avg_pool1d(torch.cat([front, x], dim=1).permute(0,2,1),
                            self.ks, stride=1).permute(0,2,1)
 
    def forward(self, x):
        B = x.size(0)
        t = self._ma(x)
        return self.trend(t.reshape(B,-1)) + self.seasonal((x-t).reshape(B,-1))
 
 
class FITSModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        W, inp = cfg["window_size"], cfg["input_dim"]
        cut = min(cfg["fits_cut_freq"], W // 2 + 1)
        self.cut  = cut
        self.freq = nn.Linear(cut * 2 * inp, cfg["output_dim"])
        self.norm = nn.LayerNorm(inp)
 
    def forward(self, x):
        B, W, C = x.shape
        xf   = torch.fft.rfft(self.norm(x), dim=1)[:, :self.cut, :]
        flat = torch.cat([xf.real, xf.imag], dim=1).reshape(B, -1)
        return self.freq(flat)
 
 
class ProbSparseAttention(nn.Module):
    def __init__(self, d, n_heads, factor=5):
        super().__init__()
        self.mha    = nn.MultiheadAttention(d, n_heads, batch_first=True, dropout=0.1)
        self.factor = factor
 
    def forward(self, x):
        B, T, D = x.shape
        n_q = max(1, min(int(self.factor * math.log(T + 1)), T))
        idx = torch.randperm(T, device=x.device)[:n_q]
        out, _ = self.mha(x[:, idx, :], x, x)
        result = torch.zeros_like(x); result[:, idx, :] = out
        return result
 
 
class InformerModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        d = cfg["transformer_d_model"]
        self.proj   = nn.Linear(cfg["input_dim"], d)
        self.pos    = PositionalEncoding(d)
        self.layers = nn.ModuleList([nn.ModuleDict({
            "attn":  ProbSparseAttention(d, cfg["transformer_nhead"]),
            "norm1": nn.LayerNorm(d),
            "ffn":   nn.Sequential(nn.Linear(d, cfg["transformer_dim_ff"]), nn.GELU(),
                        nn.Dropout(0.1), nn.Linear(cfg["transformer_dim_ff"], d)),
            "norm2": nn.LayerNorm(d),
        }) for _ in range(min(cfg["transformer_num_layers"], 3))])
        self.head = nn.Sequential(nn.Linear(d, d//2), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(d//2, cfg["output_dim"]))
 
    def forward(self, x):
        h = self.pos(self.proj(x))
        for lyr in self.layers:
            h = lyr["norm1"](h + lyr["attn"](h))
            h = lyr["norm2"](h + lyr["ffn"](h))
        return self.head(h[:, -1, :])
 
# ── 15-A. iTransformer (ICLR 2024) ──────────────────────────
class iTransformerModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        W = cfg["window_size"]
        d = cfg["transformer_d_model"]
        self.token_proj = nn.Linear(W, d)
        self.norm_in    = nn.LayerNorm(d)
        enc = nn.TransformerEncoderLayer(
            d_model=d, nhead=cfg["transformer_nhead"],
            dim_feedforward=cfg["transformer_dim_ff"],
            dropout=cfg["transformer_dropout"],
            batch_first=True, activation='gelu')
        self.encoder  = nn.TransformerEncoder(enc, num_layers=cfg["transformer_num_layers"])
        self.norm_out = nn.LayerNorm(d)
        self.head = nn.Sequential(
            nn.Linear(d, d // 2), nn.GELU(),
            nn.Dropout(cfg["transformer_dropout"]),
            nn.Linear(d // 2, cfg["output_dim"]))
 
    def forward(self, x):
        h = self.token_proj(x.permute(0, 2, 1))
        h = self.norm_in(h)
        h = self.encoder(h)
        h = self.norm_out(h).mean(dim=1)
        return self.head(h)
 
 
# ── 15-B. TimeMixer (ICLR 2024) ──────────────────────────────
class _TimeMixerBlock(nn.Module):
    def __init__(self, d_model: int, seq_len: int, scale: int):
        super().__init__()
        ds = max(1, seq_len // scale)
        self.pool = nn.AdaptiveAvgPool1d(ds)
        self.mix  = nn.Sequential(
            nn.Linear(ds, ds * 2), nn.GELU(), nn.Linear(ds * 2, ds))
        self.up   = nn.Linear(ds, seq_len)
        self.norm = nn.LayerNorm(d_model)
 
    def forward(self, x):
        h = self.pool(x.permute(0, 2, 1))
        h = self.mix(h)
        h = self.up(h).permute(0, 2, 1)
        return self.norm(x + h)
 
 
class TimeMixerModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        W = cfg["window_size"]
        d = cfg["mixer_hidden"]
        scales = [s for s in [1, 2, 4] if W // s >= 1]
        self.proj   = nn.Linear(cfg["input_dim"], d)
        self.blocks = nn.ModuleList([_TimeMixerBlock(d, W, s) for s in scales])
        self.norm   = nn.LayerNorm(d)
        self.head   = nn.Sequential(
            nn.Linear(d, d // 2), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(d // 2, cfg["output_dim"]))
 
    def forward(self, x):
        h = self.proj(x)
        for blk in self.blocks:
            h = blk(h)
        return self.head(self.norm(h).mean(dim=1))
 
# ── 15-C. ModernTCN (ICLR 2024) ──────────────────────────────
class _ModernTCNBlock(nn.Module):
    def __init__(self, d_model: int, large_kernel: int, dropout: float = 0.1):
        super().__init__()
        pad          = large_kernel // 2
        self.dw_conv = nn.Conv1d(d_model, d_model, large_kernel,
                                  padding=pad, groups=d_model)
        self.bn      = nn.BatchNorm1d(d_model)
        self.pw1     = nn.Conv1d(d_model, d_model * 4, 1)
        self.pw2     = nn.Conv1d(d_model * 4, d_model, 1)
        self.act     = nn.GELU()
        self.drop    = nn.Dropout(dropout)
 
    def forward(self, x):
        h = self.act(self.bn(self.dw_conv(x)))
        h = self.drop(self.act(self.pw1(h)))
        return x + self.pw2(h)
 
 
class ModernTCNModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        d  = cfg.get("modern_tcn_d", 128)
        nl = cfg.get("modern_tcn_layers", 3)
        W  = cfg["window_size"]
        lk = cfg.get("modern_tcn_kernel", 11)
        lk = min(lk, W * 2 + 1)
        lk = lk if lk % 2 == 1 else lk + 1
 
        self.proj   = nn.Linear(cfg["input_dim"], d)
        self.blocks = nn.Sequential(*[_ModernTCNBlock(d, lk) for _ in range(nl)])
        self.head   = nn.Sequential(
            nn.Linear(d, d // 2), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(d // 2, cfg["output_dim"]))
 
    def forward(self, x):
        h = self.proj(x).permute(0, 2, 1)
        h = self.blocks(h).mean(dim=2)
        return self.head(h)
 
 
# ── 15-D. TiDE (Google, NeurIPS 2023) ────────────────────────
class TiDEModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        flat = cfg["window_size"] * cfg["input_dim"]
        h    = cfg.get("tide_hidden", 256)
        nl   = cfg.get("tide_num_layers", 2)
 
        enc = [nn.Linear(flat, h), nn.GELU(), nn.Dropout(0.1)]
        for _ in range(nl - 1):
            enc += [nn.Linear(h, h), nn.GELU(), nn.Dropout(0.1)]
        self.encoder = nn.Sequential(*enc)
 
        self.res  = nn.Linear(flat, h)
        self.norm = nn.LayerNorm(h)
        self.head = nn.Sequential(
            nn.Linear(h, h // 2), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(h // 2, cfg["output_dim"]))
 
    def forward(self, x):
        flat = x.reshape(x.size(0), -1)
        h    = self.norm(self.encoder(flat) + self.res(flat))
        return self.head(h)
 
 
# ── 15-E. Koopa (NeurIPS 2023) ────────────────────────────────
class KoopaModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        W, C = cfg["window_size"], cfg["input_dim"]
        d    = cfg.get("koopa_hidden", 128)
        cut  = min(cfg["fits_cut_freq"], W // 2 + 1)
        self.cut = cut
 
        self.freq_proj = nn.Linear(cut * 2 * C, d)
        self.koopman   = nn.Linear(C, d, bias=False)
        self.trend_ff  = nn.Sequential(nn.Linear(d, d), nn.GELU())
 
        self.norm = nn.LayerNorm(d * 2)
        self.head = nn.Sequential(
            nn.Linear(d * 2, d), nn.GELU(),
            nn.Dropout(0.1), nn.Linear(d, cfg["output_dim"]))
 
    def forward(self, x):
        B, W, C = x.shape
        trend    = x.mean(dim=1, keepdim=True).expand(-1, W, -1)
        seasonal = x - trend
 
        xf   = torch.fft.rfft(seasonal, dim=1)[:, :self.cut, :]
        freq = torch.cat([xf.real, xf.imag], dim=1).reshape(B, -1)
        h_f  = self.freq_proj(freq)
 
        h_t  = self.trend_ff(self.koopman(trend[:, -1, :]))
 
        h = self.norm(torch.cat([h_f, h_t], dim=-1))
        return self.head(h)
 
 
class RLinearModel(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        W, C = cfg["window_size"], cfg["input_dim"]
        self.revin = _RevIN(C)
        self.individual = cfg.get("linear_individual", False)
        if self.individual:
            self.linears = nn.ModuleList(
                [nn.Linear(W, cfg["output_dim"]) for _ in range(C)])
        else:
            self.linear = nn.Linear(W * C, cfg["output_dim"])
 
    def forward(self, x):
        x = self.revin(x)
        if self.individual:
            out = torch.stack(
                [self.linears[i](x[:, :, i]) for i in range(x.size(2))], dim=0
            ).mean(dim=0)
            return out
        return self.linear(x.reshape(x.size(0), -1))

