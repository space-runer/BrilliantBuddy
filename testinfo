class TrainOnlyScaler:
    def __init__(self):
        self.mean_: Optional[np.ndarray] = None
        self.std_:  Optional[np.ndarray] = None
 
    def fit(self, X: np.ndarray) -> "TrainOnlyScaler":
        self.mean_ = X.mean(axis=0, keepdims=True)
        self.std_  = X.std(axis=0, keepdims=True)
        self.std_  = np.where(self.std_ < 1e-8, 1.0, self.std_)
        return self
 
    def transform(self, X: np.ndarray) -> np.ndarray:
        assert self.mean_ is not None
        return (X - self.mean_) / self.std_
 
    def fit_transform(self, X: np.ndarray) -> np.ndarray:
        return self.fit(X).transform(X)
 
 
def normalize_features(features: np.ndarray, cfg: dict,
                        raw_train_size: int) -> np.ndarray:
    if not cfg.get("normalize_features", True):
        return features
    scaler = TrainOnlyScaler()
    scaler.fit(features[:raw_train_size])
    return scaler.transform(features).astype(np.float32)
 
 
