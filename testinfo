class AdaptivePenaltyFocalLoss(nn.Module):
    def __init__(self, gamma: float = 2.0, alpha: float = 0.75):
        super().__init__()
        self.gamma = gamma
        self.alpha = alpha
 
    def _focal_bce(self, logits, targets):
        p   = torch.sigmoid(logits)
        ce  = F.binary_cross_entropy_with_logits(logits, targets, reduction='none')
        p_t = p * targets + (1 - p) * (1 - targets)
        a_t = self.alpha * targets + (1 - self.alpha) * (1 - targets)
        return a_t * (1 - p_t) ** self.gamma * ce
 
    def forward(self, logits, targets,
                tracker: Optional[ErrorPenaltyTracker] = None,
                use_penalty: bool = True):
        focal = self._focal_bce(logits, targets)
        if tracker is None or not use_penalty:
            return focal.mean()
        fp_w, fn_w = tracker.get_penalty_weights(logits.size(0))
        penalty = torch.where(targets == 0, fp_w, fn_w)
        return (penalty * focal).mean()
 
 
