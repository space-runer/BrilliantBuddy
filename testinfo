class _null_context:
    def __enter__(self): return self
    def __exit__(self, *_): pass
 
 
def train_one_model(name: str, cfg: dict, device: torch.device,
                    gpu_ids: list, features: np.ndarray, labels: np.ndarray,
                    stream=None) -> dict:
    run_cfg   = {**cfg, "model_type": name}
    log_lines: List[str] = []
    def log(msg): log_lines.append(msg)
 
    ctx = torch.cuda.stream(stream) if stream else _null_context()
    with ctx:
        try:
            set_seed(cfg["seed"])
 
            N_raw          = len(features)
            raw_train_size = int(N_raw * run_cfg["train_ratio"])
            normed_features = normalize_features(features, run_cfg, raw_train_size)
            log(f"  归一化: {'已开启 (仅训练集fit)' if run_cfg.get('normalize_features', True) else '已关闭'}")
            log(f"  自适应惩罚: {'已启用' if run_cfg.get('use_adaptive_penalty', True) else '已关闭'}")
 
            full_ds, train_ds, val_ds, train_loader, val_loader, _ = make_loaders(
                normed_features, labels, run_cfg, num_workers=0)
 
            model      = build_model(run_cfg)
            num_params = sum(p.numel() for p in model.parameters() if p.requires_grad)
            log(f"  参数量: {num_params:,}")
 
            if len(gpu_ids) > 1:
                model = nn.DataParallel(model, device_ids=gpu_ids)
            model = model.to(device)
 
            trainer = Trainer(model, run_cfg, device)
            t_start = time.time()
            trainer.fit(train_loader, val_loader, log_lines=log_lines)
            elapsed = time.time() - t_start
 
            if trainer.tracker is not None:
                stats = trainer.tracker.get_stats()
                log(f"  [惩罚统计] 平均FP: {stats['mean_fp_penalty']:.2f}x  "
                    f"平均FN: {stats['mean_fn_penalty']:.2f}x  "
                    f"最高惩罚维度: {stats['top3_penalized_dims']}")
 
            eval_model = (model.module if isinstance(model, nn.DataParallel) else model).to(device)
            val_loss, val_preds, val_targets = trainer.validate(val_loader)
            metrics    = trainer.compute_metrics(val_preds, val_targets)
            test_preds = predict_on_dataset(eval_model, val_ds, device, run_cfg)
            global_m   = compute_global_metrics(test_preds, val_ds, run_cfg)
            detail_str = format_last_n_periods(test_preds, val_ds, run_cfg, name, show_n=10)
 
            torch.save({"model_state": eval_model.state_dict(), "config": run_cfg},
                       f"model_{name}.pt")
 
            return {
                "model":           name,
                "params":          num_params,
                "val_loss":        val_loss,
                "hit_rate_top_k":  metrics["hit_rate_top_k"],
                "avg_top_correct": global_m["avg_top_correct"],
                "train_time_s":    elapsed,
                "log_lines":       log_lines,
                "detail_str":      detail_str,
                "error":           None,
            }
 
        except Exception as e:
            import traceback
            log(f"  ✗ 训练异常: {e}")
            log(traceback.format_exc())
            return {
                "model": name, "params": 0, "val_loss": 99.9,
                "hit_rate_top_k": 0.0,
                "avg_top_correct": 0.0,
                "train_time_s": 0,
                "log_lines": log_lines, "detail_str": "", "error": str(e),
            }
 
 
