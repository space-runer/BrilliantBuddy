# 1. 自适应错误惩罚追踪器
# ============================================================
 
class ErrorPenaltyTracker:
    def __init__(self, output_dim: int, cfg: dict, device: torch.device):
        self.output_dim = output_dim
        self.alpha      = cfg["penalty_ema_alpha"]
        self.max_p      = cfg["penalty_max"]
        self.min_p      = cfg["penalty_min"]
        self.scale_fp   = cfg["penalty_scale_fp"]
        self.scale_fn   = cfg["penalty_scale_fn"]
        self.threshold  = cfg["penalty_threshold"]
        self.device     = device
        self.ema_fp     = torch.zeros(output_dim, device=device)
        self.ema_fn     = torch.zeros(output_dim, device=device)
        self.step_count = 0
 
    @torch.no_grad()
    def update(self, logits: torch.Tensor, targets: torch.Tensor):
        probs   = torch.sigmoid(logits.detach())
        preds   = (probs >= self.threshold).float()
        fp_rate = ((preds == 1) & (targets == 0)).float().mean(dim=0)
        fn_rate = ((preds == 0) & (targets == 1)).float().mean(dim=0)
        self.ema_fp = (1 - self.alpha) * self.ema_fp + self.alpha * fp_rate
        self.ema_fn = (1 - self.alpha) * self.ema_fn + self.alpha * fn_rate
        self.step_count += 1
 
    @torch.no_grad()
    def get_penalty_weights(self, batch_size: int) -> Tuple[torch.Tensor, torch.Tensor]:
        if self.step_count == 0:
            ones = torch.ones(1, self.output_dim, device=self.device)
            return ones, ones
        bc   = 1.0 - (1 - self.alpha) ** self.step_count
        fp_w = torch.clamp(1.0 + self.scale_fp * self.ema_fp / bc,
                           min=self.min_p, max=self.max_p).unsqueeze(0)
        fn_w = torch.clamp(1.0 + self.scale_fn * self.ema_fn / bc,
                           min=self.min_p, max=self.max_p).unsqueeze(0)
        return fp_w, fn_w
 
    def get_stats(self) -> dict:
        if self.step_count == 0:
            return {"max_fp_penalty": 1.0, "max_fn_penalty": 1.0,
                    "mean_fp_penalty": 1.0, "mean_fn_penalty": 1.0,
                    "top3_penalized_dims": []}
        fp_w, fn_w = self.get_penalty_weights(1)
        fp_w = fp_w.squeeze(0)
        fn_w = fn_w.squeeze(0)
        combined = (fp_w + fn_w) / 2
        top3_vals, top3_idx = combined.topk(min(3, self.output_dim))
        return {
            "max_fp_penalty":      fp_w.max().item(),
            "max_fn_penalty":      fn_w.max().item(),
            "mean_fp_penalty":     fp_w.mean().item(),
            "mean_fn_penalty":     fn_w.mean().item(),
            "top3_penalized_dims": [(i.item(), v.item())
                                    for i, v in zip(top3_idx, top3_vals)],
        }
 
    def reset(self):
        self.ema_fp.zero_()
        self.ema_fn.zero_()
        self.step_count = 0
 
 
