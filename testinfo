class SlidingWindowDataset(Dataset):
    def __init__(self, features: np.ndarray, labels: np.ndarray,
                 output_dim: int, window_size: int = 3):
        assert len(features) == len(labels)
        self.features    = torch.FloatTensor(features)
        self.raw_labels  = labels
        self.output_dim  = output_dim
        self.window_size = window_size
        self.length      = len(features) - window_size + 1
        self.binary_labels = torch.zeros(len(features), output_dim)
        for i in range(len(features)):
            for idx in labels[i]:
                if 0 <= idx < output_dim:
                    self.binary_labels[i, idx] = 1.0
 
    def __len__(self):
        return self.length
 
    def __getitem__(self, idx):
        x = self.features[idx: idx + self.window_size]
        y = self.binary_labels[idx + self.window_size - 1]
        return x, y
 
 
def _get_raw_label(dataset, local_idx: int, window_size: int) -> np.ndarray:
    if isinstance(dataset, Subset):
        window_idx = dataset.indices[local_idx]
        return dataset.dataset.raw_labels[window_idx + window_size - 1]
    return dataset.raw_labels[local_idx + window_size - 1]
 
 
def _dataset_len(dataset) -> int:
    return len(dataset.indices) if isinstance(dataset, Subset) else len(dataset)
 
 
